{
  "name": "grad-school",
  "version": "0.0.5",
  "description": "graph logic and traversal",
  "main": "./src/index.js",
  "unpkg": "./builds/grad-school.cjs",
  "module": "./builds/grad-school.mjs",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "require": "./builds/grad-school.cjs",
      "import": "./builds/grad-school.mjs",
      "default": "./builds/grad-school.cjs"
    }
  },
  "scripts": {
    "watch": "node --watch ./scratch.js",
    "build": "rollup -c --silent",
    "prepack": "npm test",
    "test": "npm run build && tape \"./tests/**/*.test.js\"",
    "lint": "eslint ."
  },
  "files": [
    "src/",
    "builds/"
  ],
  "repository": "github:spencermountain/grad-school",
  "engines": {
    "node": ">=12"
  },
  "author": "Spencer Kelly <spencermountain@gmail.com> (https://spencermountain.dev)",
  "prettier": {
    "trailingComma": "none",
    "semi": false,
    "singleQuote": true,
    "printWidth": 100
  },
  "devDependencies": {
    "@rollup/plugin-terser": "^1.0.0",
    "eslint": "10.5.0",
    "rollup": "4.63.4",
    "tap-dancer": "0.4.0",
    "tape": "5.10.2"
  },
  "license": "MIT"
}
